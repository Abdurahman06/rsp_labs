erDiagram
    USERS {
        uuid id PK
        string role
        string full_name
        string email
        string phone
        datetime created_at
    }

    ROOMS {
        uuid id PK
        string room_number
        string category
        decimal price_per_night
        string status
        int capacity
    }

    SERVICES {
        uuid id PK
        string name
        decimal price
        string description
    }

    BOOKINGS {
        uuid id PK
        uuid user_id FK
        uuid room_id FK
        uuid service_id FK
        date check_in_date
        date check_out_date
        decimal total_cost
        string status
    }

    PAYMENTS {
        uuid id PK
        uuid booking_id FK
        decimal amount
        string payment_method
        string status
        datetime paid_at
    }

    USERS ||--o{ BOOKINGS : "makes"
    ROOMS ||--o{ BOOKINGS : "reserved_in"
    SERVICES ||--o{ BOOKINGS : "included_in"
    BOOKINGS ||--o{ PAYMENTS : "paid_by"
