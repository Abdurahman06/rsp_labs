erDiagram
    USERS {
        uuid id PK
        string role
        string full_name
        string email
        string phone
        datetime created_at
    }

    HOTELS {
        uuid id PK
        string name
        string city
        string address
        decimal rating
        string description
    }

    ROOMS {
        uuid id PK
        uuid hotel_id FK
        string room_number
        string category
        decimal price_per_night
        string status
        int capacity
    }

    BOOKINGS {
        uuid id PK
        uuid user_id FK
        uuid room_id FK
        date check_in_date
        date check_out_date
        decimal total_cost
        string status
    }

    REVIEWS {
        uuid id PK
        uuid user_id FK
        uuid hotel_id FK
        int rating
        string comment
        datetime created_at
    }

    HOTELS ||--o{ ROOMS : "contains"
    USERS ||--o{ BOOKINGS : "makes"
    ROOMS ||--o{ BOOKINGS : "reserved_in"
    USERS ||--o{ REVIEWS : "writes"
    HOTELS ||--o{ REVIEWS : "receives"
